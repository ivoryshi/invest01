  "factors": [
    {
      "id": "P1",
      "dimension": "量价",
      "name": "趋势位置",
      "formula": "收盘价相对MA20/60/200的偏离；价格调整口径必须一致。",
      "fields": [
        {
          "id": "ma20",
          "name": "距MA20",
          "unit": "%"
        },
        {
          "id": "ma60",
          "name": "距MA60",
          "unit": "%"
        },
        {
          "id": "ma200",
          "name": "距MA200",
          "unit": "%"
        }
      ]
    },
    {
      "id": "P2",
      "dimension": "量价",
      "name": "成交活跃度",
      "formula": "当日成交额/此前20日平均成交额；指数不得以ETF成交替代。",
      "fields": [
        {
          "id": "volumeRatio",
          "name": "成交额相对20日",
          "unit": "倍"
        }
      ]
    },
    {
      "id": "P3",
      "dimension": "量价",
      "name": "换手率分位",
      "formula": "自由流通口径，过去3年历史分位，口径缺失时不计算。",
      "fields": [
        {
          "id": "turnoverRank",
          "name": "换手率分位",
          "unit": "%"
        }
      ]
    },
    {
      "id": "P4",
      "dimension": "量价",
      "name": "高点回撤",
      "formula": "当前价格/过去252日最高收盘价−1；非正数。",
      "fields": [
        {
          "id": "drawdown",
          "name": "距一年高点",
          "unit": "%"
        }
      ]
    },
    {
      "id": "P5",
      "dimension": "量价",
      "name": "上涨宽度",
      "formula": "定义内成分股站上MA200的比例，必须提供样本范围与覆盖率。",
      "fields": [
        {
          "id": "breadth",
          "name": "站上MA200比例",
          "unit": "%"
        }
      ]
    },
    {
      "id": "F1",
      "dimension": "基本面",
      "name": "收入增长",
      "formula": "最新可比季度或半年收入同比，严禁把累计同比直接相减。",
      "fields": [
        {
          "id": "revenue",
          "name": "收入同比",
          "unit": "%"
        }
      ]
    },
    {
      "id": "F2",
      "dimension": "基本面",
      "name": "利润率变化",
      "formula": "营业利润率较上年同期变化；百分点。",
      "fields": [
        {
          "id": "margin",
          "name": "利润率同比变化",
          "unit": "pp"
        }
      ]
    },
    {
      "id": "F3",
      "dimension": "基本面",
      "name": "资本回报",
      "formula": "非金融优先ROIC；银行使用ROE。两者标注分开。",
      "fields": [
        {
          "id": "roic",
          "name": "ROIC",
          "unit": "%"
        },
        {
          "id": "roe",
          "name": "ROE",
          "unit": "%"
        }
      ]
    },
    {
      "id": "F4",
      "dimension": "基本面",
      "name": "盈利现金含量",
      "formula": "TTM经营现金流/TTM净利润；亏损、银行等不按此比率判读。",
      "fields": [
        {
          "id": "cashQuality",
          "name": "经营现金流/净利润",
          "unit": "倍"
        }
      ]
    },
    {
      "id": "F5",
      "dimension": "基本面",
      "name": "资本开支负担",
      "formula": "TTM现金资本开支/TTM经营现金流；分母为非正数时不按常规比率判读。",
      "fields": [
        {
          "id": "capexBurden",
          "name": "资本开支/经营现金流",
          "unit": "%"
        }
      ]
    },
    {
      "id": "V1",
      "dimension": "价值",
      "name": "PE TTM",
      "formula": "亏损时不适用；当前价格与TTM盈利，保留币种和股本口径。",
      "fields": [
        {
          "id": "pe",
          "name": "PE TTM",
          "unit": "倍"
        }
      ]
    },
    {
      "id": "V2",
      "dimension": "价值",
      "name": "PB",
      "formula": "结合ROE观察；净资产非正时不作便宜程度排序。",
      "fields": [
        {
